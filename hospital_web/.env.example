# Supabase Configuration
REACT_APP_SUPABASE_URL=your_project_url_here
REACT_APP_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Web Push VAPID Keys
REACT_APP_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# Twilio Configuration (for SMS alerts)
TWILIO_ACCOUNT_SID=your_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=your_twilio_number_here

# Mapbox Configuration (Optional - App uses MapLibre by default)
# REACT_APP_MAPBOX_TOKEN=your_mapbox_token_here
